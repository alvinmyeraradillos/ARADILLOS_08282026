{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "//": "Supplied per environment. Never commit a real connection string; use ConnectionStrings__FileProcessingDb or user secrets.",
    "FileProcessingDb": ""
  },

  "FileProcessing": {
    "MaxFileSizeInBytes": 10485760,
    "MaxRows": 100000,
    "MaxRetainedErrors": 100,
    "AllowedExtensions": [ ".csv" ],
    "AllowedContentTypes": [
      "text/csv",
      "application/csv",
      "text/plain",
      "application/vnd.ms-excel",
      "application/octet-stream"
    ],
    "AllowedCurrencies": [ "AUD", "NZD", "USD", "EUR", "GBP", "SGD" ],
    "RejectDuplicateUploads": false
  },

  "RateLimiting": {
    "UploadPermitLimit": 20,
    "UploadWindowSeconds": 60,
    "GlobalPermitLimit": 300,
    "GlobalWindowSeconds": 60
  },

  "Authentication": {
    "ApiKey": {
      "HeaderName": "X-Api-Key",
      "Realm": "file-processing",
      "//": "Clients are supplied per environment. Only SHA-256 digests are ever stored.",
      "Clients": []
    }
  }
}
