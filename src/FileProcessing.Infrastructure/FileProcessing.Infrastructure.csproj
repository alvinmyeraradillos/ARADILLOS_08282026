      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>compile; build; buildtransitive; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FileProcessing.Core\FileProcessing.Core.csproj" />
  </ItemGroup>

</Project>
