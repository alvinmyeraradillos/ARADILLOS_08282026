    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.0" />
    <!-- compile assets are needed for IDesignTimeDbContextFactory; PrivateAssets keeps the
         `dotnet ef` tooling out of anything that references this project, and out of the
         published output. -->
